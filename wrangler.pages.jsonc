{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rhia",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "RHIA_MEMORY",
        "class_name": "RhiaMemoryStore",
        "script_name": "rhia-memory-store"
      }
    ]
  },
  "vars": {
    "RHIA_DEPLOYMENT_ENV": "production",
    "RHIA_MIGRATION_ENABLED": "false"
  },
  "env": {
    "preview": {
      "durable_objects": {
        "bindings": [
          {
            "name": "RHIA_MEMORY",
            "class_name": "RhiaMemoryStore",
            "script_name": "rhia-memory-store-preview"
          }
        ]
      },
      "vars": {
        "RHIA_DEPLOYMENT_ENV": "preview",
        "RHIA_MIGRATION_ENABLED": "false"
      }
    },
    "production": {
      "durable_objects": {
        "bindings": [
          {
            "name": "RHIA_MEMORY",
            "class_name": "RhiaMemoryStore",
            "script_name": "rhia-memory-store"
          }
        ]
      },
      "vars": {
        "RHIA_DEPLOYMENT_ENV": "production",
        "RHIA_MIGRATION_ENABLED": "false"
      }
    }
  }
}
