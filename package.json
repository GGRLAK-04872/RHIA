{
  "name": "rhia",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "test": "npm run build && npm run test:node && npm run test:worker && npm run check:memory-boundaries && npm run check:bundles",
    "test:node": "node --test tests/*.test.mjs",
    "test:worker": "XDG_CONFIG_HOME=.wrangler/config vitest run --config vitest.config.js",
    "check:memory-boundaries": "node scripts/check-memory-boundaries.mjs",
    "check:bundles": "node scripts/check-bundles.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=22"
  }
}
